
# Django settings
# Comma-separated hosts accepted by Django.
ALLOWED_HOSTS=localhost,127.0.0.1
# Enable Django debug mode only for local development.
DEBUG=False
# Secret used to sign Django data.
SECRET_KEY=replace-with-a-long-random-secret-key
# Public base URL used when building file links.
BASE_URL=http://localhost:8080
# Comma-separated trusted browser origins.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Key used to sign JWT tokens.
SIMPLE_JWT_SIGNING_KEY=replace-with-a-long-random-jwt-key
# Port used by the Django development server in Docker.
PORT=8080
# Enable secure cookies and HTTPS settings when TLS is configured.
USE_HTTPS=False

# External APIs
# Base URL of the geolocation API.
GEO_API_URL=
# Authentication token for the geolocation API.
GEO_API_TOKEN=
# Comma-separated origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production workers
# Number of Gunicorn workers; a common formula is (2 x CPU cores) + 1.
GUNICORN_WORKERS=3
# Number of tasks processed concurrently by each Celery worker.
CELERY_CONCURRENCY=2
# Time zone used by Celery for scheduled tasks.
TIMEZONE=Europe/Kyiv

# Database
# PostgreSQL database name.
POSTGRES_DB=
# PostgreSQL user name.
POSTGRES_USER=
# PostgreSQL user password.
POSTGRES_PASSWORD=
# PostgreSQL service hostname in Docker.
POSTGRES_HOST=db
# PostgreSQL service port.
POSTGRES_PORT=5432

# Redis cache and Celery broker
# Redis ACL username used by the application.
REDIS_USER=app_user
# Redis ACL password for the application user.
REDIS_USER_PASSWORD=
# Redis service hostname in Docker.
REDIS_HOST=redis
# Redis service port.
REDIS_PORT=6379

# Email (optional; console email is used when EMAIL_HOST is empty)
# SMTP server hostname.
EMAIL_HOST=
# SMTP server port.
EMAIL_PORT=587
# SMTP authentication username.
EMAIL_HOST_USER=
# SMTP authentication password.
EMAIL_HOST_PASSWORD=
# Enable TLS for the SMTP connection.
EMAIL_USE_TLS=True
# Sender address used for outgoing email.
DEFAULT_FROM_EMAIL=noreply@example.com

# Error monitoring (optional)
# Sentry project DSN; leave empty to disable event delivery.
SENTRY_DSN=