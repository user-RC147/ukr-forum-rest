{
  "title": "Django — ukr-forum-rest",
  "uid": "django-ukr-forum",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "level",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"backend\"}, level)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "module",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"backend\"}, module)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "request_id",
        "type": "textbox",
        "label": "Request ID (для трассировки)",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log rate by level",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(rate({job=\"backend\", level=~\"$level\"}[$__auto])) by (level)",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "WARNING" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "INFO" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Log rate by module",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(rate({job=\"backend\", module=~\"$module\"}[$__auto])) by (module)",
          "legendFormat": "{{module}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors",
      "description": "За выбранный диапазон времени (time picker сверху)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"backend\", level=\"ERROR\"}[$__range]))", "refId": "A", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Warnings",
      "description": "За выбранный диапазон времени (time picker сверху)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"backend\", level=\"WARNING\"}[$__range]))", "refId": "A", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total log lines",
      "description": "За выбранный диапазон времени (time picker сверху)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "sum(count_over_time({job=\"backend\"}[$__range]))", "refId": "A", "instant": true }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top exception types",
      "description": "Только через custom_exception_handler (module=exceptions)",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "topk(10, sum by (exception_type) (count_over_time({job=\"backend\", level=\"ERROR\"} | json | exception_type!=\"\" [$__range])))",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Errors by module",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"backend\", level=\"ERROR\"}[$__range])) by (module)",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top views with 5xx",
      "description": "Пусто/без колонки view = ошибка не прошла через custom_exception_handler (см. django.server вместо config.exceptions)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "topk(10, sum by (view) (count_over_time({job=\"backend\", level=\"ERROR\"} | json | status_code >= 500 [$__range])))",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Live errors",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{job=\"backend\", level=~\"WARNING|ERROR\"} | json | line_format \"{{.timestamp}} [{{.level}}] {{.module}} req_id={{.request_id}} — {{.message}}\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "All logs (filtered)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{job=\"backend\", level=~\"$level\", module=~\"$module\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Trace by Request ID",
      "description": "Заполни переменную request_id сверху, чтобы увидеть все логи одного запроса",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 42 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{job=\"backend\"} | json | request_id=\"$request_id\" | line_format \"{{.timestamp}} [{{.level}}] {{.module}} — {{.message}}\"",
          "refId": "A"
        }
      ]
    }
  ]
}